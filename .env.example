# Copiar para `.env` e preencher. O `.env` nunca vai para o git.
#
# Isto aponta para uma base de dados LOCAL, na tua máquina. Não é a base da
# intranet — ver o README, secção "Montar a base de dados".

DB_TYPE=mssql
DB_SERVER=localhost
DB_DATABASE=RadiosDev
DB_PORT=1433

# Autenticação. Preencher os dois é o caminho testado (é o que a intranet usa em
# produção): cria um login SQL na tua instância local e mete-o aqui.
# Deixá-los vazios faz o db.js tentar autenticação integrada do Windows — o
# caminho existe no código mas não é o que está rodado.
DB_USER=radios_dev
DB_PASSWORD=

NODE_ENV=development

# Caminho do ficheiro que o `npm run importar` lê. Só é preciso se o ficheiro
# não estiver no sítio do costume (OneDrive da PM).
# XLSX_RADIOS=C:\Users\...\Radios apanhado.xlsx

# Base dos telemoveis. Mesma instancia e mesmo login do DB_USER acima; so
# muda o nome da base. Sem esta variavel, os telemoveis usam a DB_DATABASE.
DB_DATABASE_TELEMOVEIS=TelemoveisDev
